{
  "name": "dev-bigi-school",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "lint": "eslint .",
    "test": "npm test -w backend",
    "seed": "npm run seed -w backend",
    "desktop:dist": "node desktop/build.cjs",
    "desktop:run": "electron .local/desktop-stage",
    "desktop:verify": "node desktop/verify.cjs",
    "desktop:verify:lan": "node desktop/verify-lan.cjs",
    "desktop:test": "node --test --test-concurrency=1 desktop/test/*.test.cjs",
    "format": "prettier --write frontend/src backend/src backend/test frontend/index.html frontend/vite.config.js eslint.config.js package.json frontend/package.json backend/package.json README.md"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^9.2.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.5.0",
    "prettier": "^3.10.1"
  },
  "type": "module"
}
